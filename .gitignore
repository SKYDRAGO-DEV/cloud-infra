*_override.tf.json
.terraformrc
terraform.rc

# Environment files
.env
.env.*
!.env.example

# Credentials / keys
*.pem
*.key
*.p12
*.pfx

# Local/editor artifacts
.DS_Store
.idea/
.vscode/
